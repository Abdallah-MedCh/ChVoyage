{
  "kind": "collectionType",
  "collectionName": "distinations",
  "info": {
    "singularName": "distination",
    "pluralName": "distinations",
    "displayName": "Distination",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Name": {
      "type": "string"
    },
    "Price": {
      "type": "biginteger"
    },
    "Image": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "Date": {
      "type": "date"
    },
    "Description": {
      "type": "richtext"
    },
    "Duration": {
      "type": "integer"
    },
    "dist_options": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::dist-option.dist-option"
    },
    "dID": {
      "type": "uid"
    },
    "Country": {
      "type": "string"
    },
    "Category": {
      "type": "enumeration",
      "enum": [
        "Beach",
        "Adventure",
        "Urban"
      ]
    },
    "Trans": {
      "type": "boolean"
    },
    "Visa": {
      "type": "enumeration",
      "enum": [
        "Not Required",
        "Required",
        "On Arrival",
        "e-Visa"
      ]
    },
    "planetic": {
      "type": "boolean"
    }
  }
}
